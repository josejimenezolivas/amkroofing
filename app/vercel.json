{
  "services": {
    "site": {
      "root": ".",
      "installCommand": "npm --prefix forms-web ci",
      "buildCommand": "node scripts/build.js",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "api",
      "runtime": "node",
      "entrypoint": "index.js",
      "functions": {
        "index.js": { "maxDuration": 15 }
      }
    },
    "forms": {
      "root": "forms-api",
      "runtime": "container",
      "entrypoint": "Dockerfile",
      "functions": {
        "Dockerfile": { "maxDuration": 60 }
      }
    }
  },
  "rewrites": [
    { "source": "/forms/api/(.*)", "destination": { "service": "forms" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ]
}
